{
  "name": "kettigo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "description": "Kettigo — mobile-first no-loss prize savings with passkey-owned Safe accounts.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "axios": "1.20.0",
    "decode-uri-component": "0.5.0",
    "hono": "4.13.8",
    "lodash": "4.18.1",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "stream-json": "3.7.0",
    "uuid": "14.0.2",
    "ws": "8.21.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "decode-uri-component": "0.5.0",
      "hono": "4.13.8",
      "lodash": "4.18.1",
      "postcss": "8.5.28",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "stream-json": "3.7.0",
      "uuid": "14.0.2",
      "ws": "8.21.3"
    }
  },
  "scripts": {
    "cf:build": "pnpm --filter @kettigo/web build",
    "contracts:compile": "npm run compile -w packages/contracts",
    "contracts:test": "npm run test -w packages/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia -w packages/contracts",
    "lab:dev": "npm run dev -w @kettigo/morpho-lab",
    "lab:build": "npm run build -w @kettigo/morpho-lab",
    "lab:typecheck": "npm run typecheck -w @kettigo/morpho-lab",
    "lab:test": "npm run test --workspace @kettigo/morpho-lab --",
    "landing:dev": "npm run dev -w @kettigo/landing",
    "landing:build": "npm run build -w @kettigo/landing",
    "landing:deploy": "npm run deploy -w @kettigo/landing",
    "landing:typecheck": "npm run typecheck -w @kettigo/landing",
    "landing:test": "npm run test -w @kettigo/landing",
    "web:dev": "npm run dev -w packages/web",
    "web:build": "npm run build -w packages/web",
    "keeper:morpho": "node --no-warnings --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs packages/keeper/src/run-web-keeper.mjs morpho",
    "keeper:withdrawal": "node --no-warnings --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs packages/keeper/src/run-web-keeper.mjs withdrawal",
    "keeper:all": "npm run keeper:morpho && npm run keeper:withdrawal",
    "keeper:watch": "node packages/keeper/src/watch-keepers.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
