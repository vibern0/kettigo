{
  "name": "kettigo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "description": "Kettigo — mobile-first no-loss prize savings with passkey-owned Safe accounts.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "axios": "1.20.0",
    "decode-uri-component": "0.5.0",
    "hono": "4.13.8",
    "lodash": "4.18.1",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "stream-json": "3.7.0",
    "uuid": "14.0.2",
    "ws": "8.21.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "decode-uri-component": "0.5.0",
      "hono": "4.13.8",
      "lodash": "4.18.1",
      "postcss": "8.5.28",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "stream-json": "3.7.0",
      "uuid": "14.0.2",
      "ws": "8.21.3"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint:solidity": "solhint \"packages/contracts/contracts/**/*.sol\" && pnpm lint:solidity:conditionals",
    "lint:solidity:conditionals": "! rg -n '^[[:space:]]*if \\([^\\n]+\\) (revert|return|emit|[A-Za-z_].*;)' packages/contracts/contracts -g '*.sol' && ! rg -n -U 'if \\([^\\n]+\\)\\n\\s*(revert|return|emit|[A-Za-z_][^\\n;]*;)' packages/contracts/contracts -g '*.sol'",
    "format:solidity:check": "prettier --check \"packages/contracts/contracts/**/*.sol\"",
    "cf:build": "pnpm --filter @kettigo/landing build",
    "contracts:compile": "npm run compile -w packages/contracts",
    "contracts:test": "npm run test -w packages/contracts",
    "coverage": "SOLIDITY_COVERAGE=true pnpm --dir packages/contracts exec hardhat coverage",
    "contracts:deploy:sepolia": "npm run deploy:sepolia -w packages/contracts",
    "lab:dev": "npm run dev -w @kettigo/morpho-lab",
    "lab:build": "npm run build -w @kettigo/morpho-lab",
    "lab:typecheck": "npm run typecheck -w @kettigo/morpho-lab",
    "lab:test": "npm run test --workspace @kettigo/morpho-lab --",
    "landing:dev": "npm run dev -w @kettigo/landing",
    "landing:build": "npm run build -w @kettigo/landing",
    "landing:deploy": "npm run deploy -w @kettigo/landing",
    "landing:typecheck": "npm run typecheck -w @kettigo/landing",
    "landing:test": "npm run test -w @kettigo/landing",
    "web:dev": "npm run dev -w packages/web",
    "web:build": "npm run build -w packages/web",
    "keeper:morpho": "node --no-warnings --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs packages/keeper/src/run-web-keeper.mjs morpho",
    "keeper:withdrawal": "node --no-warnings --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs packages/keeper/src/run-web-keeper.mjs withdrawal",
    "keeper:draw": "node --no-warnings --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs packages/keeper/src/run-web-keeper.mjs draw",
    "keeper:all": "node packages/keeper/src/run-all-keepers.mjs",
    "keeper:watch": "node packages/keeper/src/watch-keepers.mjs"
  },
  "lint-staged": {
    "*.sol": [
      "prettier --write",
      "solhint",
      "pnpm lint:solidity:conditionals"
    ]
  },
  "devDependencies": {
    "@cyfrin/aderyn": "0.6.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-solidity": "2.4.1",
    "solhint": "6.2.5",
    "wrangler": "4.149.0"
  }
}
