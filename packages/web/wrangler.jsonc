{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kettigo",
  "main": "worker.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "out",
    "run_worker_first": [
      "/api/client-events",
      "/",
      "/draw",
      "/draw/",
      "/profile",
      "/profile/",
      "/savings",
      "/savings/"
    ]
  },
  "vars": {
    "NEXT_PUBLIC_CHAIN_ID": "11155111",
    "NEXT_PUBLIC_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
    "NEXT_PUBLIC_CONFIDENTIAL_PRIZE_POOL_ADDRESS": "0x30530991e296a663a32567C170b290fB88578408",
    "NEXT_PUBLIC_CONFIDENTIAL_USDC_ADDRESS": "0xe64c1836b96253104a753E60188f691173Ded624",
    "NEXT_PUBLIC_PASSKEY_RP_ID": "kettigo.xyz",
    "NEXT_PUBLIC_PASSKEY_RP_NAME": "Kettigo",
    "NEXT_PUBLIC_USDC_ADDRESS": "0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238",
    "DRAW_KEEPER_MINIMUM_PRIZE": "1000000",
    "MORPHO_KEEPER_START_BLOCK": "12078643"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kettigo",
      "database_id": "d6cfede8-60bb-45dc-b342-60e6da48f1e4",
      "migrations_dir": "../landing/migrations"
    }
  ],
  "previews": {
    "vars": {
      "NEXT_PUBLIC_CHAIN_ID": "11155111",
      "NEXT_PUBLIC_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
      "NEXT_PUBLIC_CONFIDENTIAL_PRIZE_POOL_ADDRESS": "0x30530991e296a663a32567C170b290fB88578408",
      "NEXT_PUBLIC_CONFIDENTIAL_USDC_ADDRESS": "0xe64c1836b96253104a753E60188f691173Ded624",
      "NEXT_PUBLIC_PASSKEY_RP_ID": "blvieira5.workers.dev",
      "NEXT_PUBLIC_PASSKEY_RP_NAME": "Kettigo",
      "NEXT_PUBLIC_USDC_ADDRESS": "0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238",
      "DRAW_KEEPER_MINIMUM_PRIZE": "1000000",
      "MORPHO_KEEPER_START_BLOCK": "12078643"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "kettigo",
        "database_id": "d6cfede8-60bb-45dc-b342-60e6da48f1e4",
        "migrations_dir": "../landing/migrations"
      }
    ]
  }
}
