{
  "name": "@kettigo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Kettigo web app — mobile-first PWA with passkey-owned Safe accounts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && node --experimental-strip-types --import ./packages/keeper/src/register-ts-loader.mjs --test packages/web/tests/*.test.mjs packages/web/test/*.test.mjs && pnpm --dir packages/web exec vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@kettigo/protocol": "workspace:*",
    "@safe-global/protocol-kit": "8.0.7",
    "@safe-global/relay-kit": "6.1.1",
    "@safe-global/safe-modules-deployments": "3.0.10",
    "@sentry/browser": "^11.8.0",
    "@tanstack/react-query": "^5.59.0",
    "@zama-fhe/sdk": "3.6.0",
    "canvas-confetti": "1.9.4",
    "clsx": "^2.1.1",
    "motion": "14.6.0",
    "next": "15.5.27",
    "ox": "^0.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.21.30",
    "wagmi": "^2.12.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "jsdom": "30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
