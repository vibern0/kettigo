# Kettigo web — env example
# Copy to .env.local and fill in.

# ─── Chain & RPC (Sepolia) ───────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=11155111

# ─── Contract addresses (from packages/contracts deploy script) ──────────────
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_CONFIDENTIAL_USDC_ADDRESS=
NEXT_PUBLIC_CONFIDENTIAL_PRIZE_POOL_ADDRESS=

# ─── Passkey relying party ───────────────────────────────────────────────────
# Use the exact hostname serving the app. Passkeys are scoped to this value.
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
NEXT_PUBLIC_PASSKEY_RP_NAME=Kettigo

# ─── Pimlico (https://dashboard.pimlico.io → API key) ────────────────────────
NEXT_PUBLIC_PIMLICO_API_KEY=

# Netlify Scheduled Function keeper. Do not expose these as NEXT_PUBLIC_*.
SEPOLIA_RPC_URL=
KEEPER_PRIVATE_KEY=
MORPHO_KEEPER_MAX_TXS=3
WITHDRAWAL_KEEPER_LOOKBACK_BATCHES=8
