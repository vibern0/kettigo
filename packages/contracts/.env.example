# Kettigo contracts — env example
# Copy to .env and fill in.

# Deployer private key (use a fresh testnet-only key)
PRIVATE_KEY=

# Sepolia RPC URL (Alchemy, Infura, or public https://rpc.sepolia.org)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Circle official Sepolia USDC. Override only if Circle changes its docs.
SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Filled after `npm run deploy:confidential-usdc`.
CONFIDENTIAL_USDC_ADDRESS=0xe64c1836b96253104a753E60188f691173Ded624

# Filled after `npm run deploy:confidential-pool`.
CONFIDENTIAL_PRIZE_POOL_ADDRESS=0x30530991e296a663a32567C170b290fB88578408

# 24-hour rounds for the deployed Kettigo draw cadence.
DRAW_INTERVAL_SECONDS=86400
WITHDRAWAL_BATCH_INTERVAL_SECONDS=300

# Morpho Blue Sepolia yield adapter deployment.
MORPHO_BLUE_ADDRESS=0xd011EE229E7459ba1ddd22631eF7bF528d424A14
MORPHO_MARKET_ID=0x8c561f0929c3a3e2b20fba99c2ae15fc57b4d0599e4371b67c9a58388a27b9d2
MORPHO_UNWRAP_INTERVAL_SECONDS=300
MORPHO_COLLATERAL_TOKEN=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
MORPHO_ORACLE_ADDRESS=
MORPHO_IRM_ADDRESS=
MORPHO_LLTV=945000000000000000

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=

# Gas reporter (set to "true" to log gas costs in USD)
REPORT_GAS=false
