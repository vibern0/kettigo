{
  "name": "@kettigo/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Kettigo smart contracts — confidential prize savings on Sepolia.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "candidate:typecheck": "tsc -p experiments/claim-lab/candidate/tsconfig.json",
    "node": "hardhat node",
    "deploy:confidential-usdc": "hardhat run scripts/deploy-confidential-usdc.ts --network sepolia",
    "deploy:confidential-usdc:local": "hardhat run scripts/deploy-confidential-usdc.ts --network localhost",
    "deploy:confidential-pool": "hardhat run scripts/deploy-confidential-pool.ts --network sepolia",
    "deploy:confidential-pool:local": "hardhat run scripts/deploy-confidential-pool.ts --network localhost",
    "deploy:morpho-yield-adapter": "hardhat run scripts/deploy-morpho-yield-adapter.ts --network sepolia",
    "deploy:morpho-yield-adapter:local": "hardhat run scripts/deploy-morpho-yield-adapter.ts --network localhost"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/chai": "^4.3.16",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.0",
    "@zama-fhe/sdk": "3.6.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.2",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4",
    "viem": "2.55.19"
  },
  "dependencies": {
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "dotenv": "^17.4.2",
    "encrypted-types": "^0.0.4"
  }
}
