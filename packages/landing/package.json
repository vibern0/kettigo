{
  "name": "@kettigo/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc && wrangler triggers deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:browser && npm run test:worker",
    "test:browser": "vitest run --config vite.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  }
}
